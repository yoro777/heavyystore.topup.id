# ==========================================================================
# HEAVY STORE TOP UP — Environment Variables (EXAMPLE)
# --------------------------------------------------------------------------
# Copy this file to `.env` (local) or fill it in the Vercel Dashboard
# (Project → Settings → Environment Variables). NEVER commit the real `.env`.
# ALL secrets are server-side only and are never exposed to the browser.
# ==========================================================================

# --------------------------------------------------------------------------
# CORE
# --------------------------------------------------------------------------
# Public base URL of the deployment (used for redirects / callbacks)
APP_URL=https://your-project.vercel.app
NODE_ENV=production

# PostgreSQL connection string (Neon / Supabase / Vercel Postgres / RDS ...)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# JWT signing secret (min 32 random chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Extra secret required for the very first admin bootstrap (register admin)
ADMIN_SECRET=

# --------------------------------------------------------------------------
# PAYMENT GATEWAY (official API only — no scraping)
# --------------------------------------------------------------------------
# Active provider: midtrans | dana
PAYMENT_PROVIDER=midtrans

# --- Midtrans (official) https://docs.midtrans.com ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- DANA (official DANA Merchant / Open API) ---
# Only used when PAYMENT_PROVIDER=dana or as an additional channel.
DANA_CLIENT_ID=
DANA_CLIENT_SECRET=
DANA_MERCHANT_ID=
DANA_ENV=sandbox

# Generic aliases (kept for compatibility with the spec)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# --------------------------------------------------------------------------
# SUPPLIER TOP-UP (official reseller API only)
# --------------------------------------------------------------------------
# Active supplier adapter: digiflazz | vipreseller | generic
SUPPLIER_ADAPTER=digiflazz

SUPPLIER_API_URL=
SUPPLIER_API_KEY=
SUPPLIER_USERNAME=
SUPPLIER_SECRET=

# Optional per-adapter overrides (fallback to the generic values above)
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_API_URL=https://api.digiflazz.com/v1

VIPRESELLER_API_URL=
VIPRESELLER_API_KEY=
VIPRESELLER_MERCHANT_ID=

# --------------------------------------------------------------------------
# NOTIFICATIONS (optional official providers)
# --------------------------------------------------------------------------
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@your-domain.com

# WhatsApp (official gateway, e.g. Fonnte / Wablas)
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER=

# --------------------------------------------------------------------------
# SECURITY / OPS
# --------------------------------------------------------------------------
# Comma separated list of allowed origins for CORS (defaults to APP_URL)
ALLOWED_ORIGINS=
# Secret for Vercel Cron authentication (set automatically by Vercel too)
CRON_SECRET=
# Rate limit defaults (requests per window per IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
